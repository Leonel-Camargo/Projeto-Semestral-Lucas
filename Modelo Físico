create schema RShopping_DB;

create table rede_de_shopping(
CNPJ_REDE char(14) primary key not null,
razao_social varchar(100) not null,
nome_fantasia varchar(100) not null);	

select*from rede_de_shopping;

create table shopping(
CNPJ_SHOP char(14) primary key not null,
nome_shop varchar(100) not null,
cidade varchar(100) not null,
horario time not null,
CNPJ_REDE_fk char(14) not null,
foreign key (CNPJ_REDE_fk)
references rede_de_shopping (CNPJ_REDE));

create table cliente(
CPF_CLIENTE char(11) primary key not null,
nome_cliente varchar(100) not null,
cidade varchar(100),
logradouro varchar(100),
numero INT,
bairro varchar(100),
UF char(2),
CNPJ_SHOP_fk char(14) not null,
foreign key (CNPJ_SHOP_fk)
references shopping (CNPJ_SHOP));

create table estacionamento(
vaga INT primary key not null,
andar INT not null,
CNPJ_SHOP_fk char(14) not null,
foreign key (CNPJ_SHOP_fk)
references shopping (CNPJ_SHOP));

create table playcenter(
CNPJ_PLAYCENTER char(14) primary key not null,
valor_ticket decimal(4,2) not null,
nome_brinquedo varchar(100) not null,
premio varchar(100) not null,
CNPJ_SHOP_fk char(14) not null,
foreign key (CNPJ_SHOP_fk)
references shopping (CNPJ_SHOP));

create table banheiro(
id_banheiro varchar(100) primary key not null,
cabine INT not null,
hor_limpeza time,
sexo char(1) not null,
CNPJ_SHOP_fk char(14) not null,
foreign key (CNPJ_SHOP_fk)
references shopping (CNPJ_SHOP));

create table loja(
CNPJ_LOJA char(14) primary key not null,
tipo_loja varchar(100) not null,
nome_loja varchar(100) not null,
CNPJ_SHOP_fk char(14) not null,
foreign key (CNPJ_SHOP_fk)
references shopping (CNPJ_SHOP));

create table restaurante(
CNPJ_REST char(14) primary key not null,
tipo_rest varchar(100) not null,
nome_rest varchar(100) not null,
CNPJ_SHOP_fk char(14) not null,
foreign key (CNPJ_SHOP_fk)
references shopping (CNPJ_SHOP));

create table cinema(
CNPJ_CIN char(14) primary key not null,
valor INT not null,
sessao time not null,
CNPJ_SHOP_fk char(14) not null,
foreign key (CNPJ_SHOP_fk)
references shopping (CNPJ_SHOP));

create table estoque(
cod_produto varchar(100) primary key not null,
CNPJ_REST_fk char(14) not null,
CNPJ_CIN_fk char(14) not null,
foreign key (CNPJ_REST_fk)
references restaurante (CNPJ_REST),
foreign key (CNPJ_CIN_fk)
references cinema (CNPJ_CIN));

create table comida(
codigo_comida varchar(100) primary key not null,
dt_validade date not null,
tipo_comida varchar(100));

create table controle(
cod_produto varchar(100) not null,
codigo_comida varchar(100) not null,
primary key (cod_produto, codigo_comida),
foreign key (cod_produto)
references estoque (cod_produto),
foreign key (codigo_comida)
references comida (codigo_comida));

create table sala_de_cinema(
n_sala INT primary key not null,
poltrona char(3) not null,
CNPJ_CIN_fk char(14) not null,
foreign key (CNPJ_CIN_fk)
references cinema (CNPJ_CIN));

create table filme(
genero varchar(100) primary key not null,
tempo time not null);

create table exibe(
n_sala INT not null,
genero varchar(100) not null,
primary key (n_sala, genero),
foreign key (n_sala)
references sala_de_cinema (n_sala),
foreign key (genero)
references filme (genero));

create table funcionario(
CPF_FUNC char(11) primary key not null,
CLT char(7) not null,
nome_func varchar(100) not null,
funcao varchar(100) not null,
cidade varchar(100) not null,
logradouro varchar(100) not null,
numero INT not null,
bairro varchar(100) not null,
UF char(2) not null,
email varchar(100) not null,
celular char(11) not null,
CNPJ_LOJA_fk char(14) ,
CNPJ_REST_fk char(14) ,
CNPJ_CIN_fk char(14) ,
CNPJ_PLAYCENTER_fk char(14) ,
id_banheiro_fk varchar(100) ,
foreign key (CNPJ_LOJA_fk)
references loja (CNPJ_LOJA),
foreign key (CNPJ_REST_fk)
references restaurante (CNPJ_REST),
foreign key (CNPJ_CIN_fk)
references cinema (CNPJ_CIN),
foreign key (CNPJ_PLAYCENTER_fk)
references playcenter (CNPJ_PLAYCENTER),
foreign key (id_banheiro_fk)
references banheiro (id_banheiro));

